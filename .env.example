# Postgres. On Neon: DATABASE_URL = pooled (-pooler host), DIRECT_URL = direct (migrations only).
DATABASE_URL="postgresql://shiftmate:shiftmate@127.0.0.1:54329/shiftmate"
DIRECT_URL=""

# Session signing. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Canonical URL (used in magic links). e.g. https://shiftmate.vercel.app
APP_URL="http://localhost:3000"

# Magic-link email. Leave RESEND_API_KEY empty locally: links are printed to the server log.
RESEND_API_KEY=""
EMAIL_FROM="ShiftMate <onboarding@resend.dev>"

# Demo mode: enables the "Try as …" buttons and the nightly reset.
DEMO_MODE="true"
# Password for demo accounts (never shown to users). openssl rand -hex 16
DEMO_PASSWORD=""
# Optional: a real email that is kept as an admin across demo resets.
OWNER_EMAIL=""

# Vercel Cron bearer token. openssl rand -hex 24
CRON_SECRET=""
